<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AutoSwitcher.App</RootNamespace>
    <AssemblyName>AutoSwitcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.BMDSwitcherAPI">
      <HintPath>..\..\lib\Interop.BMDSwitcherAPI.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Reutiliza el cerebro y el chofer que ya escribimos (una sola fuente). -->
  <ItemGroup>
    <Compile Include="..\AutoSwitcher.Cli\ISwitcherDriver.cs" Link="Core\ISwitcherDriver.cs" />
    <Compile Include="..\AutoSwitcher.Cli\AtemDriver.cs" Link="Core\AtemDriver.cs" />
    <Compile Include="..\AutoSwitcher.Cli\SwitcherBrain.cs" Link="Core\SwitcherBrain.cs" />
  </ItemGroup>

  <!-- Copia el dashboard (wwwroot) junto al .exe para que se sirva en produccion. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
